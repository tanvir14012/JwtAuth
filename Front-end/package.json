{
  "name": "front-end",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "set NODE_OPTIONS=--openssl-legacy-provider && ng serve --ssl true --ssl-key D:/E-Documents/SelfSignedSSL/code.key --ssl-cert D:/E-Documents/SelfSignedSSL/code.crt",
    "build": "ng build",
    "build:prod": "set NODE_OPTIONS=--openssl-legacy-provider && ng build -c production --output-path dist/wwwroot --base-href /",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/material": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/router": "^18.2.14",
    "bootstrap": "^5.0.2",
    "rxjs": "~7.8.1",
    "tslib": "^2.1.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.14",
    "@angular/cli": "^18.2.14",
    "@angular/compiler-cli": "^18.2.14",
    "@types/angular": "^1.8.1",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^22.10.2",
    "browser-sync": "^3.0.4",
    "jasmine-core": "~3.7.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "typescript": "~5.5.4"
  }
}
